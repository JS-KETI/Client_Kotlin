+	/// Select the QUIC backend ("quinn" or "noq"). Must be called before `connect()`.
+	/// Defaults to quinn when never called.
+	pub fn set_backend(&self, backend: String) -> Result<(), MoqError> {
+		let parsed = match backend.to_ascii_lowercase().as_str() {
+			"quinn" => moq_native::QuicBackend::Quinn,
+			"noq" => moq_native::QuicBackend::Noq,
+			other => return Err(MoqError::Connect(format!("unknown QUIC backend: {other}"))),
+		};
+		if let Some(mut state) = self.task.lock() {
+			state.config.backend = Some(parsed);
+		}
+		Ok(())
+	}
+
