     /// poll_transmit logic for off-path data.
+    /// Weighted-deficit path ordering for `poll_transmit` (#68).
+    ///
+    /// Returns `path_ids` reordered so that data-eligible paths (validated, `Available`,
+    /// with remote CIDs) carrying a local weight come first, sorted by remaining byte
+    /// credit. Credits are replenished weight-proportionally once every weighted path
+    /// has consumed its round. With fewer than two weighted eligible paths the caller's
+    /// (ascending) order is returned unchanged, preserving legacy behavior.
+    fn weighted_path_order(&mut self, path_ids: Vec<PathId>) -> Vec<PathId> {
+        let mut weighted: Vec<(PathId, i64)> = Vec::new();
+        for &id in &path_ids {
+            let Some(path) = self.paths.get(&id) else {
+                continue;
+            };
+            if path.data.weight.is_some()
+                && path.data.validated
+                && path.data.local_status() == PathStatus::Available
+                && self.remote_cids.contains_key(&id)
+            {
+                weighted.push((id, path.data.weight_deficit));
+            }
+        }
+        if weighted.len() < 2 {
+            return path_ids;
+        }
+        // Replenish weight-proportionally when the whole round is consumed. Bounded:
+        // the first pass gives every positive-weight path a positive credit.
+        let mut guard = 0;
+        while weighted.iter().all(|&(_, d)| d <= 0) && guard < 2 {
+            guard += 1;
+            for (id, d) in weighted.iter_mut() {
+                if let Some(path) = self.paths.get_mut(id) {
+                    let cap = i64::from(path.data.weight.unwrap_or(0)) * WEIGHT_QUANTUM_BYTES;
+                    path.data.weight_deficit = (path.data.weight_deficit + cap).min(cap);
+                    *d = path.data.weight_deficit;
+                }
+            }
+        }
+        weighted.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
+        let head: Vec<PathId> = weighted.iter().map(|&(id, _)| id).collect();
+        let tail: Vec<PathId> = path_ids
+            .into_iter()
+            .filter(|id| !head.contains(id))
+            .collect();
+        let mut ordered = head;
+        ordered.extend(tail);
+        ordered
+    }
+
+    /// Debits a weighted path's byte credit for a sent transmit (#68).
+    ///
+    /// The floor keeps overspend (spillover sends while other paths are congestion
+    /// blocked) bounded to one round, so recovery bursts stay short.
+    fn weight_debit(&mut self, path_id: PathId, size: usize) {
+        if let Some(path) = self.paths.get_mut(&path_id) {
+            if let Some(w) = path.data.weight {
+                let floor = -(i64::from(w) * WEIGHT_QUANTUM_BYTES);
+                path.data.weight_deficit = (path.data.weight_deficit - size as i64).max(floor);
+            }
+        }
+    }
